// Capstone Project: Hack Computer - CPU
// Nand to Tetris - I (ETCNTC301)
// School of Engineering & Technology, K.R. Mangalam University
// Student: Priyanshu Pandey (2501730051, K = 51)

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Instruction decoding:
    // A-instruction: instruction[15] == 0
    // C-instruction: instruction[15] == 1
    Not(in=instruction[15], out=isA);
    Not(in=isA, out=isC);

    // A register multiplexer: selects instruction or ALU output
    Mux16(a=instruction, b=outALU, sel=instruction[15], out=inA);

    // A register load condition
    And(a=isC, b=instruction[5], out=cLoadA);
    Or(a=isA, b=cLoadA, out=loadA);
    ARegister(in=inA, load=loadA, out=outA, out[0..14]=addressM);

    // ALU input Y: selects between A register and inM
    Mux16(a=outA, b=inM, sel=instruction[12], out=inALUY);

    // D register load condition
    And(a=isC, b=instruction[4], out=loadD);
    DRegister(in=outALU, load=loadD, out=outD);

    // ALU computation
    ALU(x=outD, y=inALUY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=outALU,
        out=outM,
        zr=zr,
        ng=ng);

    // writeM condition
    And(a=isC, b=instruction[3], out=writeM);

    // PC jump conditions:
    Or(a=zr, b=ng, out=zrOrNg);
    Not(in=zrOrNg, out=pos);

    And(a=instruction[2], b=ng, out=jlt); // j1: out < 0
    And(a=instruction[1], b=zr, out=jeq); // j2: out == 0
    And(a=instruction[0], b=pos, out=jgt); // j3: out > 0

    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCondition);
    And(a=isC, b=jumpCondition, out=loadPC);

    PC(in=outA, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}
